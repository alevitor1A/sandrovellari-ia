{
  "manifest_version": 3,
  "name": "SandroVellari IA",
  "version": "1.0",
  "description": "Sandro IA — Assistente inteligente em qualquer site",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sandro IA"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "background": {
    "service_worker": "background.js"
  }
}